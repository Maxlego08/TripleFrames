# TripleFrames — arguments du worker de préproduction de la file default
# (spec 100 § 18, L100-15).
#
# Recopié par root en /etc/tripleframes/preprod-worker-default.env (0644, aucun
# secret), lu par l'EnvironmentFile de tripleframes-preprod-worker@.service.
#
# Bornes mémoire dans le même ordre qu'en production : --memory < memory_limit
# < MemoryMax du drop-in. --sleep=10 : file presque toujours vide en recette.
#
# Syntaxe : une affectation par ligne, commentaire en DÉBUT de ligne seulement.
PHP_ARGS=-d memory_limit=112M
WORKER_ARGS=--tries=3 --backoff=10 --sleep=10 --timeout=120 --max-time=3600 --memory=96
