# TripleFrames — arguments du worker de préproduction de la file game
# (spec 100 § 18, L100-15).
#
# Recopié par root en /etc/tripleframes/preprod-worker-game.env (0644, aucun
# secret), lu par l'EnvironmentFile de tripleframes-preprod-worker@.service.
#
# Mêmes options de cadencement qu'en production (ops/systemd/worker-game.env :
# --tries=1, --sleep=0.1), pour que les parcours Playwright mesurent le vrai
# comportement des frontières de palier ; seules les bornes mémoire baissent,
# dans le même ordre : --memory < memory_limit < MemoryMax du drop-in.
#
# Syntaxe : une affectation par ligne, commentaire en DÉBUT de ligne seulement.
PHP_ARGS=-d memory_limit=96M
WORKER_ARGS=--tries=1 --sleep=0.1 --timeout=30 --max-time=3600 --memory=64
