# TripleFrames — .env de référence de la PRÉPRODUCTION (spec 100 § 18, L100-15).
#
# Ce fichier n'est PAS un .env : il liste, pour la mise en service de
# l'abonnement preprod.<DOMAINE> (ops/mise-en-service.md § 12), ce qui DIFFÈRE
# du .env de production (100 § 10.10). Le .env réel est écrit à la main sur le
# serveur, 0600, hors dépôt ; aucune valeur ci-dessous n'est un secret, et
# chaque secret (APP_KEY, mots de passe, REVERB_APP_SECRET, OPS_PROBE_TOKEN)
# naît sur le serveur, jamais recopié de la production.
#
# Règle : jamais une donnée, une image, une clé ni un identifiant de production.

# Environnement nommé de la préproduction (n° 5, D66 du 07/10) : seul
# environnement, avec local et testing, où DatabaseSeeder pose le catalogue de
# démonstration ; jamais les comptes de démonstration. AccountSwitches garde
# inscription et passkeys fermées tant que « true » n'est pas déclaré ici.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://preprod.<DOMAINE>

# Jamais indexée : SITE_INDEXABLE reste vide (noindex intégral, § 12), en plus
# de l'authentification HTTP des directives nginx.
SITE_INDEXABLE=
ACCOUNTS_REGISTRATION_OPEN=
ACCOUNTS_PASSKEYS_ENABLED=

# Base MySQL SÉPARÉE, créée par Plesk pour l'abonnement de préproduction.
DB_CONNECTION=mysql
DB_DATABASE=[base de préproduction]
DB_USERNAME=[utilisateur de la base de préproduction]
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

# Instance Redis de préproduction (ops/redis/tripleframes-preprod-redis.conf) :
# port et mot de passe propres, jamais ceux de la production.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=[port Redis de préproduction]
REDIS_PASSWORD=
REDIS_QUEUE_RETRY_AFTER=960

# Reverb de préproduction (ops/systemd/tripleframes-preprod-reverb.service).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=[port Reverb de préproduction]
REVERB_HOST=127.0.0.1
REVERB_PORT=[port Reverb de préproduction]
REVERB_SCHEME=http
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=
REVERB_CLIENT_SCHEME=
REVERB_ALLOWED_ORIGINS=preprod.<DOMAINE>

# Racines propres à l'abonnement de préproduction, hors de son chemin de
# déploiement ; aucune n'est sauvegardée (rien n'y est irremplaçable).
FRAMES_DISK_ROOT=[racine frames de préproduction]
AVATARS_DISK_ROOT=[racine avatars de préproduction]
BACKUP_SNAPSHOT_DIR=[répertoire d'instantanés de préproduction]

# Aucun e-mail ne part de la préproduction : journal seulement.
MAIL_MAILER=log

# Aucune clé TMDB ni OAuth : la préproduction ne fait ni import ni connexion
# sociale (catalogue de démonstration seulement).
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

LOG_STACK=daily
LOG_DAILY_DAYS=7
