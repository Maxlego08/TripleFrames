APP_NAME=TripleFrames
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# `single` sur le poste ; `daily` en production, où les journaux vivent 14 jours
# au plus (spec 100 § 10.9).
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Indexation (spec 100 § 12). Fausse : toute réponse porte `noindex, nofollow`.
# Fausse en production au jalon 1 ; sa levée au jalon 2 se fait dans le seul
# environnement de production, jamais par une valeur du dépôt.
SITE_INDEXABLE=false

# Inscription et passkeys (spec 40 § 8.2). Vides = non déclarées : ouvertes en
# local et testing seulement, fermées partout ailleurs. Leur ouverture au jalon
# 2 se fait dans le seul environnement de production, jamais ici.
ACCOUNTS_REGISTRATION_OPEN=
ACCOUNTS_PASSKEYS_ENABLED=

# Adresse de contact des pages légales (spec 90 § 4.3). Vide = aucune adresse
# publiée : le bloc de contact affiche une mention traduite à la place, jusqu'à
# ce qu'une adresse qui répond existe (achat du domaine). Jamais écrite ici.
LEGAL_CONTACT_EMAIL=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Racine du disque privé des images de jeu. Vide = storage/app/frames.
# Hors local et testing : chemin ABSOLU hors du répertoire de déploiement, jamais sous public/.
# AppServiceProvider::assertFramesDiskRoot() lève si la variable est vide ou sous la racine du projet.
FRAMES_DISK_ROOT=
# File et cache sur Redis, via predis, sur le poste comme en production : le
# driver database n'est jamais une file de moteur, il sonde et verrouille des
# lignes et ne tient pas une frontière de palier (spec 60 § 19.5). L'hôte Redis
# de développement (VM Homestead ou Redis local) se règle dans .env. Seuls les
# tests gardent leurs drivers en mémoire (phpunit.xml).
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis et non phpredis : aucune ext-redis sous Windows ; poste, CI et
# production se comportent pareil (spec 100 § 10.10).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Au-dessus du `$timeout` de 900 s de l'import de catalogue : en deçà, un job
# encore en cours serait délivré une seconde fois (spec 100 § 10.3).
REDIS_QUEUE_RETRY_AFTER=960

# Reverb (spec 60 § 19.5, spec 100 § 10.10). Identifiant et clé d'application
# PUBLICS par conception : la clé est servie à tout client. Le secret reste vide
# ici et naît sur la machine. Publication serveur en boucle locale, en clair.
REVERB_APP_ID=tripleframes-local
REVERB_APP_KEY=tripleframes-local-key
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Écoute de reverb:start, toujours en boucle locale ; nginx publie /app/ en
# production, jamais l'API /apps/.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Borne d'une requête reçue par Reverb, donc de toute diffusion (en octets) :
# game.ended d'une partie aux bornes pèse jusqu'à ~500 Ko (mesure E108-4,
# EventPayloadTest ; à reporter en spec 60 § 19.5 et 100 § 10.10). 512 Kio est
# un plancher : ne jamais descendre en dessous.
REVERB_MAX_REQUEST_SIZE=524288
# Ce que le navigateur vise, lu au runtime (prop realtime), à la place de toute
# variable VITE_REVERB : hôte et schéma vides = ceux de la page. Le port client
# reste égal au port d'écoute sur le poste, où l'application est servie sur un
# autre port ; vide en production, où nginx publie /app/ sur le port 443.
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=8080
REVERB_CLIENT_SCHEME=
# Origines admises, séparées par des virgules. Vide = `*`, pour le poste
# seulement ; `<DOMAINE>` en production (spec 100 § 10.5).
REVERB_ALLOWED_ORIGINS=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Import et curation du catalogue SEULEMENT : aucun appel TMDB pendant une partie.
# Les deux lignes restent VIDES dans cet exemple. Vide = absent : l'import se désactive
# avec un message clair, la CI tourne sans clé et le catalogue de démonstration reste
# jouable. Le jeton v4 (en-tête Authorization) prime sur la clé v3 (paramètre d'URL,
# qui fuite dans les journaux d'accès et les referrers) ; poser les deux est inutile.
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=

# Voie capture du back-office (spec 20 § 5.4, D38 du 28/09). Vide ou absente =
# ouverte ; `false` la ferme — en un geste, si le conseil répond non sur la
# licéité de l'acte de capture. Fermée, le serveur refuse la route capture.
CURATION_CAPTURE_ENABLED=

# Drainage de déploiement (spec 100 § 11.3). Borne d'attente en minutes : vide =
# dérivée de la plus longue partie possible, plus une marge qui couvre une
# pause. Fenêtre libre accordée une fois le drainage abouti, en minutes.
DEPLOY_DRAIN_TIMEOUT_MINUTES=
DEPLOY_WINDOW_MINUTES=30

# Instantanés avant migration ou geste de console sur le catalogue (spec 100
# § 13.1). Répertoire vide = storage/app/snapshots sur le poste ; hors local et
# testing, chemin ABSOLU hors du répertoire de déploiement. Rétention en jours,
# ramenée à 30 au plus.
BACKUP_SNAPSHOT_DIR=
BACKUP_SNAPSHOT_KEEP_DAYS=7

# Jeton des sondes de supervision, en-tête X-Probe-Token (spec 100 § 15). Vide =
# toute sonde répond 404. Secret long propre à la production, jamais ici.
OPS_PROBE_TOKEN=
# Nombre de vCPU de la machine pour la sonde de charge (spec 100 § 15). Vide =
# compté dans /proc/cpuinfo ; à renseigner depuis le relevé du VPS (nproc) si
# l'open_basedir de l'abonnement n'admet pas ce fichier.
OPS_LOAD_CPU_COUNT=
